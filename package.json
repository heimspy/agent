{
    "name": "@heimspy/agent",
    "version": "0.12.1",
    "description": "Heimspy capture sessions, rules, MCP and versioned client protocol",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/heimspy/agent.git"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "exports": {
        "./model": "./src/shared/model.ts",
        "./protoRaw": "./src/shared/protoRaw.ts",
        "./format": "./src/utils/format.ts",
        "./protocol": "./src/agent/protocol.ts",
        "./paths": "./src/agent/paths.ts",
        "./main": "./src/agent/main.ts",
        "./engine": "./src/core/engine.ts",
        "./testing": "./src/test/helpers/helpers.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "src/agent",
        "src/core",
        "src/shared",
        "src/utils/format.ts",
        "src/test/helpers/helpers.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node esbuild.mjs",
        "start": "node dist/agent.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write src scripts/*.mjs esbuild.mjs package.json",
        "format:check": "prettier --check src scripts/*.mjs esbuild.mjs package.json",
        "test:core": "node scripts/build-test-core.mjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "node-forge": "^1.3.1",
        "protobufjs": "^8.8.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "@types/node-forge": "^1.3.11",
        "esbuild": "^0.25.0",
        "prettier": "^3.6.0",
        "typescript": "^5.9.0",
        "vitest": "^4.0.0"
    }
}
